# Copy this file to .env and fill it in.
TELEGRAM_BOT_TOKEN=123456789:paste-token-from-BotFather
# Comma-separated Telegram chat ids allowed to use the bot (get yours with /id)
ALLOWED_CHAT_IDS=
# Full path to the workbook with the Visible Alpha formulas
WORKBOOK_PATH=C:\Users\you\Documents\VA_Bot.xlsx
# Sheet / cells the /q command uses
TEMPLATE_SHEET=Bot
INPUT_CELL=B1
OUTPUT_RANGE=A3:F40
# Seconds to wait for Visible Alpha to finish loading
CALC_TIMEOUT=60
